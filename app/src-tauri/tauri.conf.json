{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shouting Iguana",
  "mainBinaryName": "shouting-iguana",
  "version": "2.1.0",
  "identifier": "uk.co.aptitude.shoutingiguana",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:51874",
    "beforeDevCommand": "npm run vite",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; object-src 'none'; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "publisher": "Aptitude",
    "category": "DeveloperTool",
    "shortDescription": "SEO crawler and site auditor",
    "longDescription": "Shouting Iguana crawls a website and audits it for SEO issues.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/si-sidecar"],
    "fileAssociations": [
      {
        "ext": ["sicrawl"],
        "name": "Shouting Iguana crawl",
        "description": "Shouting Iguana crawl",
        "role": "Editor",
        "mimeType": "application/x-shouting-iguana-crawl"
      }
    ],
    "macOS": {
      "signingIdentity": "-",
      "hardenedRuntime": false
    },
    "linux": {
      "deb": {
        "depends": ["libnss3", "libasound2t64 | libasound2"],
        "desktopTemplate": "linux/main.desktop",
        "files": {
          "/usr/share/mime/packages/shouting-iguana.xml": "linux/shouting-iguana.xml"
        }
      },
      "appimage": {
        "files": {
          "/usr/lib/libssl.so.3": "/usr/lib/x86_64-linux-gnu/libssl.so.3"
        }
      }
    },
    "windows": {
      "signCommand": { "cmd": "node", "args": ["../scripts/sign.mjs", "%1"] },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "headerImage": "nsis/header.bmp",
        "sidebarImage": "nsis/sidebar.bmp",
        "installerHooks": "nsis/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3QTU3QjNCNDYyQTU4MUUKUldRZVdDcEdPM3VsOTlHa1duRjU4bC9WVzVMbzdpSFJ4NkxBTTJnSzJsMjBrT29WeUNHU014aWoK",
      "endpoints": ["https://github.com/YodasMyDad/ShoutingIguana/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
