<Project>

    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Engine">
        <PackageVersion Include="AngleSharp" Version="1.9.0" />
        <PackageVersion Include="AngleSharp.XPath" Version="2.0.4" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />
        <PackageVersion Include="Microsoft.Playwright" Version="1.56.0" />
        <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
        <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
    </ItemGroup>

    <ItemGroup Label="CLI">
        <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.14" />
        <PackageVersion Include="System.CommandLine" Version="2.0.14" />
    </ItemGroup>

    <!-- The sidecar's log file, beside the console log on stderr. -->
    <ItemGroup Label="Sidecar">
        <PackageVersion Include="Serilog" Version="4.3.0" />
        <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
        <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <!-- DocumentFormat.OpenXml is in the tests only: it reads back the workbooks an export writes, and validates them against the format's schema. -->
    <ItemGroup Label="Tests">
        <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />
        <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
        <PackageVersion Include="xunit" Version="2.9.3" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    </ItemGroup>

</Project>
