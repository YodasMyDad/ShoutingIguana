<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <RootNamespace>ShoutingIguana.Engine</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The schema.org vocabulary and ISO 4217 codes structured-data-schema-errors checks against (Analysis/Vocabulary/generate.mjs). -->
        <EmbeddedResource Include="Analysis\Vocabulary\schema-org.json" LogicalName="schema-org.json" />
        <None Remove="Analysis\Vocabulary\generate.mjs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AngleSharp" />
        <PackageReference Include="Microsoft.Data.Sqlite" />
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
        <PackageReference Include="System.IO.Hashing" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ShoutingIguana.Engine.Tests" />
        <!-- The sidecar's tests make an export's disk fill up, and its pages small, by the seams the engine's own tests use. -->
        <InternalsVisibleTo Include="ShoutingIguana.Sidecar.Tests" />
        <!-- si readbench times the grids' reads as a crawl without a URL summary has them, without changing the file. -->
        <InternalsVisibleTo Include="si" />
        <!-- si recheck's tests make a recheck fail part-way, by the seam the engine's own tests use. -->
        <InternalsVisibleTo Include="ShoutingIguana.Cli.Tests" />
    </ItemGroup>

</Project>
