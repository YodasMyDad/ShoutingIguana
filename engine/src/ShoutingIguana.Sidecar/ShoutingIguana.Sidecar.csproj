<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>si-sidecar</AssemblyName>
        <RootNamespace>ShoutingIguana.Sidecar</RootNamespace>
        <!-- A desktop app's companion: workstation GC keeps the footprint small, as for the CLI. -->
        <ServerGarbageCollection>false</ServerGarbageCollection>
        <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    </PropertyGroup>

    <!--
        The app ships this as one file. Playwright's driver is a node executable and a folder of scripts
        (.playwright), which have to be files on disk. A single file carries only the executable unless told to carry
        everything, and then the scripts were left behind in the publish folder, so the installed app could not render.
        With this the whole bundle is unpacked on first start, .playwright with it, and AppContext.BaseDirectory is
        that folder, where Playwright looks.
    -->
    <PropertyGroup Condition="'$(PublishSingleFile)' == 'true'">
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Serilog" />
        <!-- The browser driver has to sit beside this executable, not only beside the engine. -->
        <PackageReference Include="Microsoft.Playwright" />
        <PackageReference Include="Serilog.Extensions.Logging" />
        <PackageReference Include="Serilog.Sinks.File" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\ShoutingIguana.Engine\ShoutingIguana.Engine.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="ShoutingIguana.Sidecar.Tests" />
    </ItemGroup>

</Project>
